# Copy to .env.local and fill in what you need. All values are optional for local browsing.

# Required in production for upload / import / delete (any long random string).
# Without it those actions are refused in production and open in local dev.
ADMIN_API_KEY=

# GitHub release-asset storage + cloud ingest workflow
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=aurasound-music-data
GITHUB_RELEASE_TAG=tracks-v1

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# SoundCloud
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_FALLBACK_CLIENT_ID=

# Listening-room sync server
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
